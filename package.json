{
  "name": "noman-kinetic-portfolio",
  "version": "2.0.0",
  "private": true,
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve.mjs out",
    "preview": "node scripts/serve.mjs out",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:export": "node scripts/check-export.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run check:export"
  },
  "dependencies": { "next": "^16.3.0", "react": "^19.2.8", "react-dom": "^19.2.8" },
  "devDependencies": { "@types/node": "^22.0.0", "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "typescript": "~5.9.2" }
}
